# Copie este arquivo para .env e preencha (o .env NUNCA vai para o GitHub)
DATABASE_URL=postgresql://<USUARIO>:<SENHA>@<SERVIDOR>/<BANCO>?sslmode=verify-full&channel_binding=require
PORT=3000
NODE_ENV=development
JWT_SECRET=mysupersecretpassword
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
SYNC_DATABASE=false
ERASE_DATABASE_ON_SYNC=false

# Copie este arquivo para .env e preencha com os seus dados (o .env nunca vai para o GitHub)
DATABASE_URL=postgresql://<USUARIO>:<SENHA>@<SERVIDOR>/<BANCO>?sslmode=verify-full&channel_binding=require
SYNC_DATABASE=false
ERASE_DATABASE_ON_SYNC=false
# Segredo usado para assinar os tokens de login. Use um texto longo e aleatório.
JWT_SECRET=troque-por-um-texto-longo-e-aleatorio

{
  "info": {
    "name": "Caronas Universitárias API",
    "description": "1) Rode um Login: o token fica salvo na variável {{token}}. 2) Os pedidos de listar e criar salvam os ids nas variáveis (caronaId, veiculoId...). 3) Para trocar de usuário, rode outro Login. Altere baseUrl em Variables para o endereço da Vercel.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    },
    {
      "key": "usuarioId",
      "value": ""
    },
    {
      "key": "veiculoId",
      "value": ""
    },
    {
      "key": "caronaId",
      "value": ""
    },
    {
      "key": "reservaId",
      "value": ""
    },
    {
      "key": "avaliacaoId",
      "value": ""
    }
  ],
